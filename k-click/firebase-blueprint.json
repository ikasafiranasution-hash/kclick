{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with credits and role",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "profileImage": { "type": "string", "maxLength": 2048 },
        "role": { "type": "string", "enum": ["user", "creator", "admin"] },
        "credits": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "credits"]
    },
    "Product": {
      "title": "Product",
      "description": "Digital marketplace items like photobooth templates, frames, stickers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "previewImage": { "type": "string", "maxLength": 500000 },
        "productFile": { "type": "string", "maxLength": 500000 },
        "tags": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "salesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "creatorId", "name", "category", "price", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase transaction for digital items with QR payment proof",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "buyerEmail": { "type": "string", "maxLength": 150 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 150 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "waiting_verification", "paid", "rejected"] },
        "proofImage": { "type": "string", "maxLength": 500000 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "verifiedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "buyerId", "productId", "amount", "status"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "User photobooth strips and saved creations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["photobooth", "purchased", "custom"] },
        "fileUrl": { "type": "string", "maxLength": 500000 },
        "templateId": { "type": "string", "maxLength": 128 },
        "templateName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "fileUrl"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User favorited products",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review and rating from verified buyer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "productId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "productId", "rating"]
    },
    "Category": {
      "title": "Category",
      "description": "Marketplace category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Marketplace items and photobooth templates"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Digital orders and payment proofs"
    },
    "/gallery/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "User saved photobooth creations and purchased assets"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Bookmarked favorite creations"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Ratings and reviews for marketplace items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Category tags for marketplace"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Authorized administrators"
    }
  }
}
