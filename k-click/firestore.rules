rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['klick.wd@gmail.com', 'kclick.wd@gmail.com', 'ikasafira04@gmail.com'] ||
          request.auth.token.email.matches('.*admin.*')
        ))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']) ||
          (
            request.resource.data.credits is int &&
            request.resource.data.credits >= 0 &&
            request.resource.data.credits <= 500 &&
            (
              request.resource.data.credits <= resource.data.credits || 
              request.resource.data.credits <= resource.data.credits + 10
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Admins Collection - Never writable by client requests. Only provisioned securely via Firebase Console / Admin SDK.
    // Restricted read: Only the owner checking their own doc or a verified admin reading admin records.
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if resource.data.status == 'approved' || 
                     (isSignedIn() && resource.data.creatorId == request.auth.uid) || 
                     isAdmin();
      allow create: if isSignedIn() && 
                     request.resource.data.creatorId == request.auth.uid && 
                     request.resource.data.status == 'pending' &&
                     request.resource.data.price >= 0;
      allow update: if isAdmin() || 
                     (
                       isSignedIn() && 
                       resource.data.creatorId == request.auth.uid && 
                       request.resource.data.creatorId == request.auth.uid &&
                       request.resource.data.price >= 0 &&
                       (
                         request.resource.data.status == resource.data.status ||
                         (resource.data.status == 'rejected' && request.resource.data.status == 'pending')
                       ) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'creatorId', 
                         'salesCount', 
                         'rating', 
                         'reviewCount', 
                         'approved', 
                         'approvalStatus', 
                         'approvedBy', 
                         'paymentStatus', 
                         'sales', 
                         'revenue'
                       ])
                     ) ||
                     (
                       isSignedIn() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']) &&
                       request.resource.data.rating >= 0 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.reviewCount >= 0 &&
                       exists(/databases/$(database)/documents/reviews/$(request.auth.uid + '_' + productId))
                     );
      allow delete: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.buyerId == request.auth.uid) ||
                     (isSignedIn() && resource.data.creatorId == request.auth.uid) ||
                     isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.buyerId == request.auth.uid && 
        exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
        get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'approved' &&
        request.resource.data.amount == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price &&
        request.resource.data.creatorId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.creatorId &&
        (
          (get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price > 0 && 
           request.resource.data.status in ['pending', 'waiting_verification']) ||
          (get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == 0 && 
           request.resource.data.status == 'paid')
        );
      allow update: if isAdmin() || 
        (
          isSignedIn() && 
          resource.data.buyerId == request.auth.uid && 
          resource.data.status in ['pending', 'waiting_verification'] &&
          request.resource.data.status == 'waiting_verification' && 
          request.resource.data.amount == resource.data.amount &&
          request.resource.data.productId == resource.data.productId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.creatorId == resource.data.creatorId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'amount', 'price', 'productId', 'buyerId', 'creatorId', 'verifiedAt', 'verifiedBy', 'paid'
          ])
        );
      allow delete: if isAdmin();
    }

    // Purchases / Verified Entitlements Collection
    match /purchases/{purchaseId} {
      allow read: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.buyerId == request.auth.uid &&
        purchaseId == request.auth.uid + '_' + request.resource.data.productId &&
        (
          (!('price' in request.resource.data) || request.resource.data.price == 0) &&
          (!('amount' in request.resource.data) || request.resource.data.amount == 0)
        ) &&
        exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
        get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == 0
      );
      allow update, delete: if isAdmin();
    }

    // Product Views Tracking Collection (Strict validation against spam/tampering)
    match /productViews/{viewId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if request.resource.data.productId is string &&
                       request.resource.data.productId.size() > 0 &&
                       request.resource.data.productId.size() < 100 &&
                       exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
                       request.resource.data.createdAt is string &&
                       request.resource.data.userId is string &&
                       (
                         (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
                         (!isSignedIn() && request.resource.data.userId == 'anonymous')
                       ) &&
                       request.resource.data.keys().hasAll(['id', 'productId', 'userId', 'createdAt']) &&
                       request.resource.data.keys().hasOnly(['id', 'productId', 'userId', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Gallery Collection
    match /gallery/{galleryId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Reviews Collection (Enforce Paid Order / Purchases Record & Exactly 1 Review per User-Product)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        reviewId == request.auth.uid + '_' + request.resource.data.productId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        (
          exists(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + request.resource.data.productId)) ||
          (
            exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
            get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == 0
          ) ||
          isAdmin()
        );
      allow update: if isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.buyerId == request.auth.uid) || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.buyerId == request.auth.uid &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid &&
        request.resource.data.amount == get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.amount &&
        request.resource.data.status in ['pending', 'waiting_verification'] &&
        !request.resource.data.keys().hasAny(['verified', 'verifiedBy', 'verifiedAt'])
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || (resource.data.userId == 'admin' && isAdmin()))) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.userId == 'admin' ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Reports & Feedback Collection
    match /reports/{reportId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Downloads Collection
    match /downloads/{downloadId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Templates Collection
    match /templates/{templateId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.creatorId == request.auth.uid && 
        request.resource.data.creatorId == request.auth.uid
      );
      allow delete: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }
  }
}
